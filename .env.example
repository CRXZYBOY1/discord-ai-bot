# ===== การตั้งค่า Discord AI Bot =====
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ดูรายละเอียดใน README.md)

# โทเคนของบอท จาก Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# ที่อยู่ API ของผู้ให้บริการ AI (แบบ OpenAI-compatible) เช่น
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://localhost:11434/v1
AI_BASE_URL=

# กุญแจ API ของผู้ให้บริการ AI
AI_API_KEY=

# ชื่อโมเดลที่ต้องการใช้ เช่น gpt-4o-mini, gemini-2.0-flash, llama3.1
AI_MODEL=

# Channel ID ของช่องที่บอทจะตอบทุกข้อความ (คั่นด้วยเครื่องหมาย , ถ้ามีหลายช่อง)
ALLOWED_CHANNEL_IDS=

# บทบาท/บุคลิกของ AI (แก้ได้ตามต้องการ)
SYSTEM_PROMPT=คุณคือผู้ช่วย AI ที่เป็นมิตร ตอบคำถามเป็นภาษาไทยที่กระชับ เข้าใจง่าย และถูกต้อง หากไม่แน่ใจให้ตอบตามความจริงว่าไม่แน่ใจ

# จำนวนข้อความสูงสุดที่บอทจะจำต่อช่อง (คำถาม+คำตอบนับรวมกัน)
HISTORY_LIMIT=20

# โหมดเธรด: เปิดเธรดใหม่ให้แต่ละคำถามในช่องที่กำหนด (true/false)
THREAD_MODE=true

# ลบเธรดอัตโนมัติ: เธรดที่ไม่มีใครพิมพ์ต่อจนครบเวลา (นาที) จะถูกลบทิ้งพร้อมความจำของเธรด
# ทุกข้อความใหม่ในเธรดจะเลื่อนเวลาลบออกไปใหม่ — ตั้ง 0 เพื่อปิดการลบเอง
THREAD_IDLE_DELETE_MINUTES=60

# กันสแปม: จำนวนวินาทีขั้นต่ำระหว่างการถามของคนเดียวกัน (ผู้ดูแลเซิร์ฟเวอร์ไม่โดนจำกัด)
COOLDOWN_SECONDS=10

# กันสแปมเฉพาะ /draw (วินาที) เพราะสร้างรูปใช้ทรัพยากรมากกว่า
IMAGE_COOLDOWN_SECONDS=30

# model สำหรับ /draw (ต้องเป็น image model เช่น ag/gemini-3.1-flash-image)
IMAGE_MODEL=ag/gemini-3.1-flash-image

# สีกล่อง embed ของคำตอบ (เลขฐาน 16 ไม่ต้องมี #)
EMBED_COLOR=5865F2

# คำถามข้อมูลสด (อากาศ/ข่าว/ราคา ฯลฯ) บอทจับเองอัตโนมัติ ไม่ต้องใช้คำสั่ง
# ถ้าว่าง: บอทค้นเว็บเองผ่าน DuckDuckGo แล้วให้ model ปกติสรุป (แนะนำ ใช้งานได้ทันที)
# ถ้าใส่ชื่อ search model เช่น cl/perplexity/sonar: จะส่งคำถามให้ model นั้นค้นเอง (ขึ้นกับ credentials ของ router)
SEARCH_MODEL=
