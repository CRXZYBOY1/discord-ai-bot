# ===== การตั้งค่า Discord AI Bot =====
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ดูรายละเอียดใน README.md)

# โทเคนของบอท จาก Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# ที่อยู่ API ของผู้ให้บริการ AI (แบบ OpenAI-compatible) เช่น
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://localhost:11434/v1
AI_BASE_URL=

# กุญแจ API ของผู้ให้บริการ AI
AI_API_KEY=

# ชื่อโมเดลที่ต้องการใช้ เช่น gpt-4o-mini, gemini-2.0-flash, llama3.1
AI_MODEL=

# Channel ID ของช่องที่บอทจะตอบทุกข้อความ (คั่นด้วยเครื่องหมาย , ถ้ามีหลายช่อง)
ALLOWED_CHANNEL_IDS=

# บทบาท/บุคลิกของ AI (แก้ได้ตามต้องการ)
SYSTEM_PROMPT=คุณคือผู้ช่วย AI ที่เป็นมิตร ตอบคำถามเป็นภาษาไทยที่กระชับ เข้าใจง่าย และถูกต้อง หากไม่แน่ใจให้ตอบตามความจริงว่าไม่แน่ใจ

# จำนวนข้อความสูงสุดที่บอทจะจำต่อช่อง (คำถาม+คำตอบนับรวมกัน)
HISTORY_LIMIT=20
